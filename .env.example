# Copy this file to .env and fill in the values.
# --- Required (only needed for development, compose.yaml sets these itself) ---

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/dns
MONGO_DB_URL=

# Redis host name or IP, e.g. 127.0.0.1
REDIS_HOST=

# --- Optional (leave blank to use the default) ---

# Redis port (default 6379)
REDIS_PORT=

# Port to run the DNS server on (default 53)
PORT=

# Port to run the management dashboard on (default 8053)
DASHBOARD_PORT=

# Interface to bind the dashboard to (default 127.0.0.1)
DASHBOARD_HOST=
